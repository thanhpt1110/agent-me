# agent-me chat (DEV) config — all optional. The service also reads agent-me's
# shared ../configs/.env, so it can gate on the same secret as the dashboard.
# PORT=8787
# HOST=0.0.0.0
# DEPLOY_ENV=dev                                   # shows the DEV banner; set "prod" to hide
# WORKSPACE=/home/thaphan/agent-me                 # default cwd for new chats
# ADD_DIRS=/home/thaphan                           # extra dirs the agent may touch (comma-sep)
# CHAT_MODEL=                                       # e.g. claude-opus-4-8 (blank = your claude default)
# CLAUDE_BIN=claude
#
# Login password — first match wins (so it matches the dashboard "button" password):
#   CHAT_PASSWORD                  -> chat-only override
#   DASHBOARD_OPERATOR_ACTION_CODE -> same passcode that gates the dashboard's operator buttons
#   DASHBOARD_TOKEN                -> dashboard access token
#   (else) a token is generated to data/access-token.txt and printed on first start.
# These DASHBOARD_* values normally live in ../configs/.env (gitignored).
