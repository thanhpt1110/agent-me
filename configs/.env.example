# agent-me runtime config
#
# Copy this file to `.env` (in the same directory) and fill in real values.
# `.env` is gitignored; never commit secrets.
#
# After filling in, source it before running the bridge:
#   set -a; source ~/agent-me/configs/.env; set +a

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot User OAuth Token — from "OAuth & Permissions" page after installing app.
# Format: xoxb-<digits>-<digits>-<base64>
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# App-Level Token — generated under "Socket Mode" with `connections:write` scope.
# Format: xapp-<digits>-<id>-<base64>
SLACK_APP_TOKEN=xapp-REPLACE-ME

# Signing Secret — from "Basic Information" → "App Credentials".
# Used to verify Slack request signatures. Hex string.
SLACK_SIGNING_SECRET=REPLACE-ME

# Optional: restrict bridge to one Slack user ID (your own) so a leaked
# bot token can't be exploited by other workspace members. Find via:
#   curl -H "Authorization: Bearer $SLACK_BOT_TOKEN" https://slack.com/api/auth.test
# Leave blank to accept messages from any workspace member (fine for solo workspace).
SLACK_ALLOWED_USER_ID=

# ── Agent runtime ────────────────────────────────────────────────────────────
# Path to the agent-me repo root. The Slack agent runs claude here by default.
AGENT_ME_REPO_DIR=/home/agent/agent-me

# Path to the paired DevTest execution repo. New installs should use the
# renamed `devtest-wrapper` checkout. The previous environment variable name
# is still accepted by the code as a compatibility alias.
AUTO_SFA_REPO_DIR=/home/agent/devtest-wrapper

# Where the bridge stores conversation state (SQLite). XDG-compliant default;
# override if you want it somewhere else (e.g. /data/agent-me).
AGENT_ME_STATE_DIR=

# Case-sensitive passcode for operator actions (Refresh all, Refresh MCP auth)
# AND the /chat page gate. When set, /chat prompts for this passcode (cookie
# unlock); leave blank to leave /chat open. Set this only in local .env.
DASHBOARD_OPERATOR_ACTION_CODE=REPLACE-ME

# ── Slack agent backend (claude is the default) ──────────────────────────────
# The Slack bot runs the interactive agent on `claude` inside the agent-me
# workspace (terminal-like: read/edit files, shell, git, MCP). Per-thread
# sessions, live progress, and a final summary post to the same thread.
# AGENT_BACKEND=codex restores the legacy codex path.
# AGENT_BACKEND=claude
# CLAUDE_BIN=claude
# Workspace the Slack agent runs in (blank = the agent-me repo).
# SLACK_AGENT_CWD=
# claude model for the Slack agent + brief (blank = the box's login default).
# CLAUDE_MODEL=
# Per-turn timeout for the Slack agent in seconds (terminal work can be long).
# CLAUDE_TURN_TIMEOUT_S=1200
# Live-progress heartbeat (seconds): how often the Slack placeholder re-renders
# while the agent is quiet (slow MCP call, silent thinking) so the elapsed time
# + spinner keep advancing. Default 3.0; stays under Slack's chat.update budget.
# SLACK_PROGRESS_HEARTBEAT_S=3.0
# claude model for the daily/weekly/monthly brief (blank = CLAUDE_MODEL).
# CLAUDE_BRIEF_MODEL=

# ── Auto SFA MCP endpoint ───────────────────────────────────────────────────
# Streamable HTTP MCP is mounted by the dashboard service at /mcp/.
# The dashboard Auto SFA tab derives the MCP URL from the request origin by
# default, so http://agent-me.nvidia.com/auto-sfa shows http://.../mcp/ and
# https://agent-me.nvidia.com/auto-sfa shows https://.../mcp/.
# Set this only when the public endpoint must differ from the page origin.
# AUTO_SFA_MCP_PUBLIC_BASE_URL=https://agent-me.nvidia.com

# Optional host/origin allow-lists for MCP transport security. Include the
# proxy origin here when it differs from the default HTTPS agent-me host.
# AUTO_SFA_MCP_ALLOWED_HOSTS=agent-me.nvidia.com,agent-me.nvidia.com:*
# AUTO_SFA_MCP_ALLOWED_ORIGINS=https://agent-me.nvidia.com

# Optional HMAC secret for MCP confirmation tokens. If unset, the dashboard
# token/operator secret fallback is used; set a stable secret in production.
# AUTO_SFA_MCP_CONFIRMATION_SECRET=REPLACE-ME

# Optional encryption key for DevTest credentials stored by /mcp/setup.
# If unset, agent-me creates a private Fernet key file in AGENT_ME_STATE_DIR.
# Generate one with:
#   uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AUTO_SFA_MCP_CREDENTIAL_KEY=REPLACE-ME

# MCP bearer tokens created by /mcp/setup do not expire by default. Set a
# positive day count only if you want automatic expiry.
# AUTO_SFA_MCP_TOKEN_TTL_DAYS=3650

# Model override (optional). Bridge pins gpt-5.5 by default.
# CODEX_MODEL=gpt-5.5
# CODEX_TIMEOUT_S=300
# Mirror daily brief output through the Codex Slack connector to this
# Slack user's DM by email. This does not use SLACK_BOT_TOKEN.
# BRIEF_MIRROR_EMAIL=thaphan@nvidia.com

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Chat (native dashboard chat feature) ─────────────────────────────────────
# Marks the environment. "dev" shows a site-wide DEV banner; "production" hides it.
DEPLOY_ENV=production
# Default working directory for new chat sessions (blank = repo root).
# CHAT_DEFAULT_CWD=
# Extra directories, comma-separated (default: $HOME). Each one is passed to the
# agent as --add-dir AND widens the chat folder scope: its non-hidden children are
# offered in the folder picker, and CLI sessions whose cwd resolves under it (or
# under $HOME / CHAT_DEFAULT_CWD — symlinks resolved) list on the web. Add the
# workspace umbrella here when repos live outside $HOME, e.g. on a data disk.
# CHAT_ADD_DIRS=/data/agent-me.nvidia.com,/home/thaphan
# claude --model for chat turns (default: claude-opus-4-8 — "always best model").
# CHAT_MODEL=claude-opus-4-8
# claude CLI binary (the chat reuses the host's OAuth login — no API key needed).
# CHAT_CLAUDE_BIN=claude
# Hard timeout per turn in seconds (0 = none).
# CHAT_TURN_TIMEOUT_S=0
# Model context window (tokens) — denominator for the "ctx N%" gauge on the chat
# title. Default 1,000,000 (claude-opus-4-8). Lower it for smaller-window models.
# CHAT_CONTEXT_WINDOW=1000000
# List the local `claude` CLI's own sessions (terminal + Slack, everything
# `claude --resume` shows) in the web chat, not just web-started ones. Default on.
# CHAT_SHOW_NATIVE_SESSIONS=1
# System-level operating context injected into every chat turn (host, branch=big-update,
# origin=GitLab, push-after-commit, no `gh`). Leave UNSET to use the built-in default;
# set to empty to disable. Set only to override the default text.
# CHAT_APPEND_SYSTEM_PROMPT=
# /chat inherits the dashboard login gate (DASHBOARD_TOKEN / DASHBOARD_TRUST_NETWORK)
# AND adds an operator-passcode gate (DASHBOARD_OPERATOR_ACTION_CODE, above).
