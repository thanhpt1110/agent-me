[Unit]
# agent-me chat — DEV web chat that spawns persistent Claude Code sessions on this
# VM workspace. Separate from the production dashboard (:8765 on the A100); this is
# the migration target, bound to :8787 on this host.
Description=agent-me chat (DEV — Claude Code web chat, port 8787)
Documentation=https://github.com/thanhpt1110/agent-me
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-me/chat
# shares agent-me's secrets (e.g. DASHBOARD_OPERATOR_ACTION_CODE gates login). Optional ('-').
EnvironmentFile=-%h/agent-me/configs/.env
Environment=DEPLOY_ENV=dev
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=WORKSPACE=%h/agent-me
Environment=ADD_DIRS=%h
# node + ~/.local/bin so the spawned agent can use claude/cim/sshpass/vault/uv/markitdown
Environment=PATH=%h/.nvm/versions/node/v24.15.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v24.15.0/bin/node %h/agent-me/chat/src/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-me-chat

[Install]
WantedBy=default.target
