[Unit]
# DEV deployment of the agent-me dashboard on this VM (port 8787), with the
# native Chat feature. Direct access (DASHBOARD_TRUST_NETWORK=1 — no token; SSO
# is handled separately). Production (:8765, agent-me-dashboard.service) runs
# from the SAME checkout on this VM behind Caddy — restart it deliberately to
# "release"; this dev unit is the one to bounce freely while iterating.
Description=agent-me dashboard (DEV — :8787, native chat)
Documentation=https://github.com/thanhpt1110/agent-me
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/agent-me.nvidia.com/agent-me
EnvironmentFile=-%h/agent-me.nvidia.com/agent-me/configs/.env
Environment=DEPLOY_ENV=dev
Environment=DASHBOARD_TRUST_NETWORK=1
Environment=AGENT_ME_REPO_DIR=%h/agent-me.nvidia.com/agent-me
# node bin is required so the chat can spawn the `claude` CLI; ~/.local/bin for uv/cim/etc.
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run agent-me-dashboard --host 0.0.0.0 --port 8787 --forwarded-allow-ips=*
Restart=on-failure
RestartSec=3
# Only kill the dashboard process on stop/restart — NOT its children. Chat turns
# run as detached worker processes (own process group); they must survive a restart
# so an in-flight prompt isn't killed (the operator's "exit code 143"). The worker
# clears its own state + the dashboard re-tails it on reconnect.
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-me-dashboard-dev

[Install]
WantedBy=default.target
